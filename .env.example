# Copy to .env.local and fill in your values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never reference in client components
SUPABASE_SERVICE_ROLE_KEY=

# --- Bunny Stream (https://bunny.net/stream) ---
# Find these under Stream > Your Library > API (per-library API key) and the
# streaming/pull-zone hostname (e.g. vz-xxxxx.b-cdn.net).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_HOSTNAME=
# Optional: the library's READ-ONLY API key — used to verify Bunny webhook HMAC signatures
BUNNY_WEBHOOK_SECRET=